{
    "name": "dotkernel/dot-controller",
    "type": "library",
    "description": "Dotkernel controller-like middleware component with plugin and event support for any PSR-11 container",
    "license": "MIT",
    "homepage": "https://github.com/dotkernel/dot-controller",
    "keywords": [
        "controller",
        "plugin",
        "laminas",
        "mezzio",
        "psr-11"
    ],
    "authors": [
        {
            "name": "Dotkernel Team",
            "email": "team@dotkernel.com"
        }
    ],
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0 || ~8.6.0",
        "laminas/laminas-eventmanager": "^3.16",
        "mezzio/mezzio-helpers": "^5.16",
        "mezzio/mezzio-template": "^2.9 || ^3.1",
        "psr/container": "^1.1 || ^2.0",
        "psr/http-message": "^1.0 || ^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "laminas/laminas-coding-standard": "^3.0",
        "laminas/laminas-diactoros": "^3.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^12.5"
    },
    "suggest": {
        "laminas/laminas-servicemanager": "Runs the controller initializers that the ConfigProvider registers"
    },
    "autoload": {
        "psr-4": {
            "Dot\\Controller\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DotTest\\Controller\\": "test/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@test",
            "@static-analysis"
        ],
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "static-analysis": "phpstan analyse --memory-limit 1G",
        "test": "phpunit --colors=always"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "laminas/laminas-dependency-plugin": false
        }
    }
}
